                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A record which is composed of fields primarily about a digital resource referenced by a persistent identifier."@en ,
                                                                                                     "Ein Datensatz, der aus Feldern besteht, die sich hauptsächlich auf eine digitale Ressource beziehen, die durch einen persistent Identifier referenziert werden. "@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003000> "PID information record"@en ,
                                                                                                     "PID record"@en ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-4344-0837> ,
                                                                                                      <https://orcid.org/0000-0003-2804-688X> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://hdl.handle.net/11304/a027f953-b810-4f5f-94ed-9e3e61ad7e13> ,
                                                                                                                 <https://www.rd-alliance.org/system/files/PID-report_v6.1_2017-12-13_final.pdf> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "persistent identifier information record"@en ,
                                                                                                                       "persistenter Identifier Information Record"@de ;
                                                        rdfs:comment "the PID record is usually structured by the PID information profile [add LINK TO PROFILE] and stored alongside a PID"@en ;
                                                        rdfs:label "persistent identifier record"@en ,
                                                                   "persistenter Identifier Record"@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "persistent identifier Records"@de ,
                                                                                                                "persistent identifier records"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "persistent Identifier Record"@de ,
                                                                                                                "persistent identifier record"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000037
<https://purls.helmholtz-metadaten.de/hob/HDO_00000037> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000038> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A programmatic value which contains a memory address."@en ,
                                                                                                     "Ein programmatischer Wert, der eine Speicheradresse enthält."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Pointer_(computer_programming)> ;
                                                        rdfs:comment "The definition of \"value\" in the computer science sense, is still stabilising in this glossary, although should be servicable."@en ;
                                                        rdfs:label "Zeiger"@de ,
                                                                   "pointer"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000038
<https://purls.helmholtz-metadaten.de/hob/HDO_00000038> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000009> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Data which (1) are stored in a computer's memory and (2) which can be manipulated by a program."@en ,
                                                                                                     "Daten, die (1) im Speicher eines Computers hinterlegt sind und (2) durch ein (Computer-)Programm verändert werden können."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-3949-818X> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "value"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Value_(computer_science)#lrvalue> ;
                                                        rdfs:comment "The here defined value can be any amount and combination of numbers, characters or else encoding a single signifier. Here, when we refer to \"a computer's memory\", we specifically refer to the random access memory (RAM). This is not to say that memory addressed cannot be stored elsewhere, but manipulation typically occurs via RAM."@en ;
                                                        rdfs:label "programmatic value"@en ,
                                                                   "programmatischer Wert"@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "programmatic values"@en ,
                                                                                                                "programmatische Werte"@de .

