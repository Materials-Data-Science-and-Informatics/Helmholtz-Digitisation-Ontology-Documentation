###  https://purls.helmholtz-metadaten.de/hob/HDO_00001059
<https://purls.helmholtz-metadaten.de/hob/HDO_00001059> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001011> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process during which a signifier of a quality is expressed as a multitude or magnitude."@en ,
                                                                                                     "Ein geplanter Prozess, bei dem ein Zeichen einer Eigenschaft als eine Menge, Größe oder ein Ausmaß ausgedrückt wird."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Quantification_%28science%29"@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Quantifizierung"@de ,
                                                                                                                       "quantification"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "count"@en ,
                                                                                                                         "measurement"@en ;
                                                        rdfs:label "Quantifikationsprozess"@de ,
                                                                   "quantification process"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "A process during which a signal or phenomenon is expressed as a multitude or magnitude."@en ,
                                                                                                   "Ein Prozess, bei dem ein Signal oder ein Phänomen als eine Menge,  Größe oder ein Ausmaß ausgedrückt wird."@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Quantifizierungsprozesse"@de ,
                                                                                                                "quantification processes"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001060
<https://purls.helmholtz-metadaten.de/hob/HDO_00001060> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007004> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A signifier which is the output of a quantification process."@en ,
                                                                                                     "Ein Zeichen, das das Ergebnis eines Quantifizierungsprozesses ist."@de ;
                                                        rdfs:comment "During a quantification process an agent perceives a type of count quality which acts is then transformed into an output in form of a signifier of an quantity."@en ;
                                                        rdfs:label "Zeichen einer Quantiät"@de ,
                                                                   "signifier of a quantity"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001061
<https://purls.helmholtz-metadaten.de/hob/HDO_00001061> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001011> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0002233> ;
                                                                          owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019>
                                                                        ] ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0002234> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00007004>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process during which an agent perceives some quality and creates a signifier thereof."@en ,
                                                                                                     "Ein geplanter Prozess, bei dem ein Akteur eine Eigenschaft wahrnimmt und davon ein Zeichen erschafft."@de ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000116> "this class could have subclass axioms added: has participant some agent. For this class agent needs to be defined or imported. This could also be done at the instance level where the nature of the agent can be identified more clearly (i.e. machine agent, human or else)."@en ;
                                                        rdfs:comment "This is the process which creates a generically dependent contiinuant that represents a specifically dependent continuant."@en ,
                                                                     "We need to think about how to deal with the \"perception process\". Is it the same as the qualification process, or do we need a new class?"@en ;
                                                        rdfs:label "Qualifizierungsprozess"@de ,
                                                                   "qualification process"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001066
<https://purls.helmholtz-metadaten.de/hob/HDO_00001066> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000034> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A function which inheres in a bearer and is realised when that bearer allows to estimate the existence, identity, properties, or behaviours of an entity."@en ,
                                                                                                     "Eine Funktion, die einem Träger innewohnt und realisiert wird, wenn dieser Träger es ermöglicht, die Existenz, die Identität, die Eigenschaften oder das Verhalten einer Entität zu schätzen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Modell Funktion"@de ,
                                                                                                                       "model function"@en ;
                                                        rdfs:comment """Under colloquial use, entities that bear the model function are often referred to as \"the model\". Also, colloquially the term model is also used as a verb in order to express the process of (computational) modelling, e.g. \"i am going to model phenomenon xyz\").

The bearer might be material entities such as a scale model of a car, or a generically dependent continuant such as a mathematical formula that models a process. The estimation of properties may be in past (e.g. estimation of the temperature during the big bang), present (estimation of the proportions of a car through a scale model, or the prediction of a parameter based on others) or the future (estimation of a neurons membrane potential in a network). 

Models are always an abstraction of the entity that they represent. A differential equation can be used to simulate the membrane potential  of a neuron over time while the spatial extend and complexity of the neuron itself is reduced to a point process. Further models highly depend on input parameters partly determining the behavior of the model and as such are often loaded with assumptions. In that sense the model output is an estimation that can be interpreted by an agent in order to infer or indicate information about another entity (i.e. existence or else)."""@en ;
                                                        rdfs:label "Modell"@de ,
                                                                   "model"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001067
<https://purls.helmholtz-metadaten.de/hob/HDO_00001067> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001066> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0000056> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00001068>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A model which is formalised in order to be executed or resolved."@en ,
                                                                                                     "Ein Modell, das formalisiert wird, um ausgeführt oder gelöst zu werden."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Computermodell Funktion"@de ,
                                                                                                                       "computational model function"@en ,
                                                                                                                       "computergestütztes Modell"@de ;
                                                        rdfs:comment "The bearer of the computational model might be a mathematical formula such as a differential equation (e.g. predicting dynamics of a parameter over some dimension such as time). A model may be used in a process such as a computational modelling to generate simulation data."@en ;
                                                        rdfs:label "Computermodell"@de ,
                                                                   "computational model"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001068
<https://purls.helmholtz-metadaten.de/hob/HDO_00001068> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001011> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0000057> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00001067>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process during which a computational model is executed or resolved to estimate the existence, identity, properties or behaviour of an entity."@en ,
                                                                                                     "Ein geplanter Prozess, bei dem ein Computermodell ausgeführt oder aufgelöst wird, um die Existenz, die Identität, die Eigenschaften oder das Verhalten einer Entität abzuschätzen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "simulation"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "computational simulation"@en ,
                                                                                                                       "computergestützte Simluation"@de ;
                                                        rdfs:label "computational modelling"@en ,
                                                                   "computergestützte Modellierung"@de .


