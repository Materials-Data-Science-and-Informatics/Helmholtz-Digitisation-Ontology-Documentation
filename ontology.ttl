                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Information which defines the requirements that must be met in order for an entity to be considered a member of a set or a type."@en ,
                                                                                                     "Informationen, die Anforderungen definieren, die erfüllt sein müssen, damit eine Entität als Mitglied einer Gruppe oder eines Typs angesehen werden kann."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        rdfs:comment "Specifications typically list their criteria in recommendation or guidance documents, and are issued by organisations or interest groups for a field of application. Generally some form of formalisation (i.e. a compiled document) is required in order for these recommendations to be adopted by a community."@en ,
                                                                     "Specifications can be used as a reference in validation processes." ;
                                                        rdfs:label "Spezifikation"@de ,
