                                                        <http://purl.obolibrary.org/obo/OMO_0003000> "App"@de ,
                                                                                                     "app"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Anwendung"@de ,
