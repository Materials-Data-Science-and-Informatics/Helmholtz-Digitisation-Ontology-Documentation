###  https://purls.helmholtz-metadaten.de/hob/HDO_00000027
<https://purls.helmholtz-metadaten.de/hob/HDO_00000027> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A role which can be realised by any digital entity when it is used to find and access another digital entity."@en ,
                                                                                                     "Eine Rolle, die von jeder digitalen Entität realisiert werden kann, wenn sie verwendet wird, um eine andere digitale Entität zu finden und darauf zuzugreifen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Bezeichnung eines Feldes"@de ,
                                                                                                                       "Feldbezeichnung"@de ,
                                                                                                                       "field description"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://cs.stackexchange.com/questions/107439/what-is-a-key-in-computer-science> ;
                                                        rdfs:comment "In most cases, keys are strings encountered by users and/or programme. In key-value pairs, the key is used to locate one or more values structured in a field (and optionally part of a record). Good keys unambiguously reference their fields."@en ;
                                                        rdfs:label "Schlüssel"@de ,
                                                                   "key"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Schlüssel"@de ,
                                                                                                                "keys"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "Schüssel"@de ,
                                                                                                                "key"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000028
<https://purls.helmholtz-metadaten.de/hob/HDO_00000028> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000046> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A string which is (1) composed of a fixed-length sequence of digits and (2) references an exact location in a computer's memory. "@en ,
                                                                                                     "Ein String, der (1) aus einer Zeichensequenz festgeleger Länge besteht und (2) auf einen exakten Ort im Computerspeicher verweist."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Memory_address> ,
                                                                                                                 <https://www.computerhope.com/jargon/m/memoaddr.htm> ;
                                                        rdfs:comment "There is an ambiguity around \"location\" in much the same way as \"address\". Here, location is used to denote the actual physical part of the device which stores data. The memory in question is typically understood as the computer's random access memory (RAM)."@en ;
                                                        rdfs:label "Speicheradresse"@de ,
                                                                   "memory address"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000029
<https://purls.helmholtz-metadaten.de/hob/HDO_00000029> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000009> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Data which are about other data."@en ,
                                                                                                     "Daten, die andere Daten beschreiben."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-0065-0762> ,
                                                                                                      <https://orcid.org/0000-0002-1008-4530> ,
                                                                                                      <https://orcid.org/0000-0002-2209-9385> ,
                                                                                                      <https://orcid.org/0000-0002-8941-954X> ,
                                                                                                      <https://orcid.org/0000-0003-0575-2853> ,
                                                                                                      <https://orcid.org/0000-0003-2804-688X> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://techterms.com/definition/metadata> ,
                                                                                                                 <https://www.ahdictionary.com/word/search.html?q=metadata> ;
                                                        rdfs:comment "Many sources conflate metadata with informative metadata, which would be more rightly called metainformation as not all metadata is informative and some may be misinformative - please refer to definition of \"data\" and \"information\". Depending of the type of characteristics being described, metadata can either be contextual or intrinsic. Richness of metadata depends on the application case, for more information please refer to the definition of \"rich metadata\"."@en ;
                                                        rdfs:label "Metadaten"@de ,
                                                                   "metadata"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> """Data which are intended to contextualise or otherwise qualify other data. Examples include file size, date created, method used to generate the data and identifiers for people who worked on the data.
Metadata itself is considered data - as such data that is about metadata is per this here given definition also metadata."""@en ,
                                                                                                   "Daten, die dazu dienen, andere Daten in einen Kontext zu setzen oder anderweitig zu beschreiben. Beispiele dafür sind etwa die Dateigröße, das Erstellungsdatum, die Methode, mit der die Daten erzeugt wurden, und die Identifier der Personen, die an den Daten gearbeitet haben. Metadaten selber sind Daten - daher sind Daten die andere Metadaten beschreiben - per der hier gegebenen Definition - auch Metadaten."@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Metadaten"@de ,
                                                                                                                "metadata"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000030
<https://purls.helmholtz-metadaten.de/hob/HDO_00000030> rdf:type owl:Class ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An element which belongs to the set of elements linked together in a graph."@en ,
                                                                                                     "Ein Element, das zu einem Satz an Elementen gehört, die durch einen Graphen miteinander verbunden werden."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Ecke"@de ,
                                                                                                                       "point"@en ,
                                                                                                                       "vertex"@en ;
                                                        rdfs:comment "From the point of view of graph theory, nodes are treated as featureless and indivisible elements, although they may have additional structure depending on the application from which the graph arises; for instance, a semantic network is a graph in which the nodes represent concepts or classes of objects."@en ;
                                                        rdfs:label "Knoten"@de ,
                                                                   "node"@en ;
                                                        rdfs:seeAlso "https://en.wikipedia.org/wiki/Node_(computer_science)" ,
                                                                     "https://en.wikipedia.org/wiki/Vertex_(graph_theory)" ,
                                                                     "https://en.wiktionary.org/wiki/vertex" ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "nodes"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000031
<https://purls.helmholtz-metadaten.de/hob/HDO_00000031> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000009> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Data which an agent acts upon."@en ,
                                                                                                     "Daten, auf die ein Agent hinarbeitet."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "data of interest"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://dictionary.cambridge.org/us/dictionary/english/object> ,
                                                                                                                 <https://www.merriam-webster.com/dictionary/object> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "input data"@en ,
                                                                                                                         "target data"@en ;
                                                        rdfs:comment "Object data is any data which is acted upon by some agent (i.e. is the \"object\" of that agent's activity). This could include subject data, its associated metadata, or any incidental data acted upon. Naturally, object data must exist prior to the action. TODO: Check synonyms, Final approval"@en ;
                                                        rdfs:label "Objektdaten"@de ,
                                                                   "object data"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Objektdaten"@de ,
                                                                                                                "object data" .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000032
<https://purls.helmholtz-metadaten.de/hob/HDO_00000032> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000014> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A graph which has a structure conforming to an ontological graph specification."@en ,
                                                                                                     "Ein gerichteter azyklischer Graph, dessen Strukturiertheit einer ontologischen Graphenspezifikation entspricht."@den ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <ISBN:9780387355443> ,
                                                                                                                 <https://mitpress.mit.edu/books/building-ontologies-basic-formal-ontology> ,
                                                                                                                 <https://mondo.monarchinitiative.org/pages/faq/> ;
                                                        rdfs:label "Ontologischer Graph"@de ,
                                                                   "ontological graph"@en ;
                                                        rdfs:seeAlso "https://en.wiktionary.org/wiki/ontology" ,
                                                                     "https://www.wikidata.org/wiki/Q324254" ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Ontologische Graphen"@de ,
                                                                                                                "ontological graphs"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000033
<https://purls.helmholtz-metadaten.de/hob/HDO_00000033> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00006028> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Structured data which uses a formal language to model knowledge about another entity  or domain, throuh defining entities (classes) and declaring the logical relationships between them (relations)."@en ,
                                                                                                     "Strukturierte Daten, die eine formale Sprache verwenden, um Wissen über eine andere Entität oder einen Bereich zu modellieren, indem sie Entitäten (Klassen) definieren und die logischen Beziehungen zwischen ihnen (Relationen) deklarieren."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Ontology_(information_science)> ,
                                                                                                                 <https://www.w3.org/TR/ld-glossary/#ontology> ,
                                                                                                                 <https://www.w3.org/standards/semanticweb/ontology> ,
                                                                                                                 <https://www.w3.org/wiki/Good_Ontologies> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Domänenontologie"@de ,
                                                                                                                        "domain ontology"@en ,
                                                                                                                        "hybrid ontology"@en ,
                                                                                                                        "upper ontology"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "data model"@en ;
                                                        rdfs:comment "This is a broad definition of ontology that is inclusive of both digitised and non-digitised assets (e.g. a set of logical proofs on paper). Specialisations of this term (e.g. ontological graph) can be used for more semantic precision. The term \"ontology\" can also generally refer to the branch of metaphysics concerned with the types, categorisation, and relationships between things in the world. In this glossary, we concern ourselves only with the computational artifact that encodes some outcome of that domain. Most ontologies will have human-readable node and edge labels, as well as definitions and synonyms for the entities they represent. In this way, they may include terminology functions native to, e.g., controlled vocabularies, thesauri, and taxonomies. Further, most ontologies are encoded in RDF or an OWL serialisation, to support reasoning and querying. Definitions used may be domain-specific and consequently differ between fields. For example, consider the concept \"card\" which has many different meanings depending on the domain. For example, An ontology about the domain of poker would define it as the \"playing card\", while an ontology about the domain of computer hardware would define it as a \"computer hardware card\". We note that if dealing with concepts, there might be an overlap between the term ontology and the term data model. "@en ;
                                                        rdfs:label "Ontologie"@de ,
                                                                   "ontology"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "A structured collection of terms, their definitions and the relationships between them expressed in a formal manner which supports machine-driven reasoning."@en ,
                                                                                                   "Eine strukturierte Sammlung von Begriffen, ihren Definitionen und ihren Beziehungen untereinander, die in einer formalen, typischerweise maschinenlesbaren Weise ausgedrückt ist. "@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Ontologien"@de ,
                                                                                                                "Ontologies"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000034
<https://purls.helmholtz-metadaten.de/hob/HDO_00000034> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001036> ,
                                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00006084> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An information profile which describes the structure of a persistent identifier record."@en ,
                                                                                                     "Ein Informationsprofil, das die Struktur eines Persistent Identifier Records beschreibt."@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003000> "PID Informationsprofil"@de ,
                                                                                                     "PID information profile"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://ec.europa.eu/info/sites/info/files/research_and_innovation/ki0420576enn.pdf> ,
                                                                                                                 <https://www.rd-alliance.org/system/files/RDA%20Recommendation%20on%20PID%20Kernel%20Information_final.pdf> ;
                                                        rdfs:comment """Both The Research Data Alliance (RDA) and the European Open Science Cloud (EOSC) Executive Board provide definitions only for a PID kernel information profile. We note that the creation and maintenance of PID information profiles is a community-centric effort. The challenge is to ensure that profiles generated by communities are recognised and parseable by repositories (or external tools). Profiles that are both recognised and well-implemented will support automated validation and indexing of PID records, allowing a wide range of operations to be performed on the metadata discovered through persistent identifiers. For HMC and other consortia, careful curation and registration of such profiles are strongly recommended, as well as efforts to encourage reuse.

Note that there is significant overlap with the class HDO_00000035 \"persistent identifier kernel information profile\" whose only difference to the current class is that information is deemed essential. Thus in practice individuals might be asserted to and of the two classes depending on how strict they are."""@en ;
                                                        rdfs:label "Informationsprofil eines persistenten Identifiers"@de ,
                                                                   "persistent identifier information profile"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Informationsprofile von persistenten Identifier"@de ,
                                                                                                                "persistent identifier information profiles"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000035
<https://purls.helmholtz-metadaten.de/hob/HDO_00000035> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00006085> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A kernel information profile which is associated with a persistent identifier."@en ,
                                                                                                     "Das Kernelinformationsprofil welches mit einem persistenten Identifiers verbunden ist."@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003000> "PID Kernelinformationsprofil"@de ,
                                                                                                     "PID kernel information profile"@en ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0003-4322-180X> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Kernel Information Profile" ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.rd-alliance.org/system/files/RDA%20Recommendation%20on%20PID%20Kernel%20Information_final.pdf> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "persistenter Identifier Kernelinformationsprofil"@de ;
                                                        rdfs:comment "We note that the term kernel information profile could in principle be used independently of the PID concept. In practice the term is mostly used in the context of records connected to persistent identifiers however, it is inserted as a broad synonym here rather than being a separate class higher in the hierarchy."@en ;
                                                        rdfs:label "Kerninformationsprofil eines persistenten Identifiers"@de ,
                                                                   "persistent identifier kernel information profile"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Kerninformationsprofile von persistenten Identifiern"@de ,
                                                                                                                "persitent identifier kernel information profiles"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000036
<https://purls.helmholtz-metadaten.de/hob/HDO_00000036> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000039> ;
