                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A unique identifier which some agent has committed to maintain - in the long term - as a valid reference to an entity."@en ,
                                                                                                     "Ein eindeutiger Identifier, für den ein Akteur zusichert hat, dass die Referenz auf die Entität über einen langen Zeitraum gültig bleibt. "@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "persistent identifier"@en ,
                                                                                                                       "persistenter Identifier"@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://de.wikipedia.org/wiki/Persistent_Identifier> ,
                                                                                                                 <https://en.wikipedia.org/wiki/String_(computer_science)> ;
                                                        rdfs:comment "The agents maintaining persistent identifiers can be diverse, for example http://hdl.handle.net/ or http://www.ncbi.nlm.nih.gov/pubmed/"@en ;
                                                        rdfs:label "persistent unique identifier"@en ,
                                                                   "persistenter eindeutiger Identifier"@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "persistent unique identifiers"@en ,
                                                                                                                "persistente eindeutige Identifier"@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000046
<https://purls.helmholtz-metadaten.de/hob/HDO_00000046> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000007> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An data type which is composed of a finite sequence of symbols."@en ,
                                                                                                     "Ein Datentyp, der aus einer endlichen Folge von Zeichen besteht."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://de.wikipedia.org/wiki/Zeichenkette> ,
                                                                                                                 <https://en.wikipedia.org/wiki/String_(computer_science)> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Zeichenfolge"@de ,
                                                                                                                       "Zeichenkette"@de ,
                                                                                                                       "Zeichenreihe"@de ;
                                                        rdfs:comment "The characters that can be used for a string of a specific data type are typically defined by the underlying abstract data type and encoded according to a character encoding specification (i.e ASCII, ISO_8859 or Unicode). "@en ;
                                                        rdfs:label "String"@de ,
                                                                   "string"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Strings"@de ,
                                                                                                                "strings"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000047
<https://purls.helmholtz-metadaten.de/hob/HDO_00000047> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000046> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A string which is used to label and recognisably refers to an entity or class of entities."@en ,
                                                                                                     "Ein String, der einen Entität oder eine Klasse von Entitäten benennt und erkennbar auf diese verweist."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Bezeichung"@de ,
                                                                                                                       "Kennung"@de ,
                                                                                                                       "Kennzeichen"@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://de.wikipedia.org/wiki/Identifikator> ,
                                                                                                                 <https://en.wikipedia.org/wiki/String_(computer_science)> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Identifikator"@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Identifizierungszeichen"@de ;
                                                        rdfs:comment "This term is broadly defined, as it is used widely - with slight to major changes in meaning - in many different contexts (e.g. within a program code, for authentification purposes, in terms of a physical description). Subclasses of this term can and should be created for more precision."@en ;
                                                        rdfs:label "Identifier"@de ,
                                                                   "identifier"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "identifiers"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000048
<https://purls.helmholtz-metadaten.de/hob/HDO_00000048> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000047> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An identifier which has no exact string matches among all identifiers used in a system."@en ,
                                                                                                     "Ein Identifier, der keine exakte (String-)Übereinstimmung mit anderen, innerhalb eines Systems verwendeten, Identifiern aufweist. "@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://de.wikipedia.org/wiki/Identifikator> ,
                                                                                                                 <https://en.wikipedia.org/wiki/String_(computer_science)> ;
                                                        rdfs:comment "Note that a unique identifier does not guarantee unambiguous identification. A unique identifier can be (mis)used to refer to two distinct entities. Checks to prevent this must be implemented in digital systems."@en ;
                                                        rdfs:label "unique identifier"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "unique identifiers"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000101
<https://purls.helmholtz-metadaten.de/hob/HDO_00000101> rdf:type owl:Class ;
                                                        owl:equivalentClass [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000001>
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty <https://purls.helmholtz-metadaten.de/hob/HDO_00006036> ;
                                                                                                     owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_10000047>
                                                                                                   ]
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ] ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <https://purls.helmholtz-metadaten.de/hob/HDO_00006036> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_10000047>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An entity which realizes the unit role."@en ,
                                                                                                     "Eine Entität, die die Einheiten-Rolle verwirklicht." ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "unit of measurement"@en ;
                                                        rdfs:comment "A stick that has been calibrated to be one metre in length and that is used to measure a distance realises a unit role and is thus a unit. The agent doing the measuring records a length of \"3 metres\". The \"meters\" in that data is about the relevant property of the unit used to measure the length, and is the \"unit information\"."@en ,
                                                                     "This class should not be used to annotate information about units (e.g., the 'm' in '3m') as it references the actual entity that was used as a unit. Please use 'unit information' for that purpose."@en ,
                                                                     "This is an experimental class, there are some concerns about this class being so close to the class entity."@en ;
                                                        rdfs:label "Einheit"@de ,
                                                                   "unit"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000106
<https://purls.helmholtz-metadaten.de/hob/HDO_00000106> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001023> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Software which enables agents to interact with one or more databases using functions that allow access, modification, storage, retrieval, and (re)organization of data."@en ,
                                                                                                     "Software, die Benutzern die Möglichkeit gibt, mit einer oder mehreren Datenbanken zu interagieren und dabei Funktionen zu nutzen, die den Zugang, die Eingabe, die Speicherung, den Abruf und die (Neu-)Organisation von Daten in großem Umfang ermöglichen."@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003012> "DBMS"@de ,
                                                                                                     "DBMS"@en ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Database> ,
                                                                                                                 <https://www.oracle.com/database/what-is-database/> ;
                                                        rdfs:comment "It may be necessary to revisit these terms once \"system\" is added to the glossary. Because of the close relationship between them, the term \"database\" is often used casually to refer to both a database and the DBMS used to manipulate it"@en ;
                                                        rdfs:label "Datenbankmanagementsystem"@de ,
                                                                   "database management system"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000107
<https://purls.helmholtz-metadaten.de/hob/HDO_00000107> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000005> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Structured data which has structuredness conforming to a database specification."@en ,
                                                                                                     "Strukturierte Daten, deren Strukturiertheit einer Datenbankspezifikation entspricht."@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003012> "DB"@de ,
                                                                                                     "DB"@en ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Database> ,
                                                                                                                 <https://www.oracle.com/database/what-is-database/> ;
                                                        rdfs:comment "Because of the close relationship between them, the term \"database\" is often used casually to refer to both a database and the database management system used to manipulate it. Here, we use the term to refer to any organised collection of data that forms the basis of some activity and the term \"database system\" to describe the combination of a database and a database management system. It is generally assumed that the organisation of data in a database will enhance efficiency of operations such as search, retrieval, update, and auditing. These actions are usually performed through a database management system."@en ;
                                                        rdfs:label "Datenbank"@de ,
                                                                   "database"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000108
<https://purls.helmholtz-metadaten.de/hob/HDO_00000108> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000109> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A database system which is used to store and preserve digital assets following a policy or rule set that defines the storage and access norms."@en ,
                                                                                                     "Ein Datenbanksystem, das zur Speicherung und Aufbewahrung digitaler Bestände gemäß einer Richtlinie oder eines Regelwerks, das Speicher- und Zugriffsnormen definiert, verwendet wird."@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003000> "repo"@en ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Repositorium"@de ,
                                                                                                                       "Repository"@de ,
                                                                                                                       "repository"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCIT_C114457> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "digitales Repositorium"@de ;
                                                        rdfs:comment "A repository includes digital storage locations as well as some form of software used to manage digital assets. A repository can, itself, contain another repository. For example, a data lake can contain a database within it."@en ;
                                                        rdfs:label "digital repository"@en ,
                                                                   "digitales Repository"@de ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "A place where data, code, software, or other digital assets are stored."@en ,
                                                                                                   "Ein Ort, an dem Daten, Code und andere digitale Inhalte gespeichert werden."@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000109
<https://purls.helmholtz-metadaten.de/hob/HDO_00000109> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001049> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A system which is composed of (1) one or more databases and (2) a database management system."@en ,
                                                                                                     "Ein System, das aus (1) einer oder mehreren Datenbanken und (2) einem Datenbankmanagementsystem besteht."@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003000> "Datenbank"@de ,
                                                                                                     "database"@en ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003012> "DBS"@de ,
                                                                                                     "DBS"@en ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.oracle.com/database/what-is-database/> ;
                                                        rdfs:comment "Any data that is stored in a database system is typically cleaned, enriched, and transformed so it complies with the database schema (the extract-transform-load). The term database is often used colloquially to refer to a database system. Here, we try to unpack and reconcile terms that are, informally, often used interchangeably. "@en ;
                                                        rdfs:label "Datenbanksystem"@de ,
                                                                   "database system"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000110
<https://purls.helmholtz-metadaten.de/hob/HDO_00000110> rdf:type owl:Class ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "OBSOLETE A unit role which is realized when some quality of an entity is used to measure a corresponding quality of another."@en ,
                                                                                                     "OBSOLETE TBD "@de ;
                                                        <http://purl.obolibrary.org/obo/IAO_0100001> <https://purls.helmholtz-metadaten.de/hob/HDO_10000047> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://doi.org/10.1351/goldbook.> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Unit_of_measurement> ,
                                                                                                                 <https://en.wikipedia.org/wiki/1> ,
                                                                                                                 "ISO/IEC Guide 99:2007" ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "measurement unit"@en ;
                                                        rdfs:comment "Extraneous to unit role - can be inferred if needed." ;
                                                        rdfs:label "obsolete TBD (Maßeinheit Rolle)"@de ,
                                                                   "obsolete unit of measurement role"@en ;
                                                        owl:deprecated "true"^^xsd:boolean ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "TBD"@de ,
                                                                                                                "unit of measurement roles"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "TBD"@de ,
                                                                                                                "unit of measurement role"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000111
<https://purls.helmholtz-metadaten.de/hob/HDO_00000111> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030> ,
                                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00000025> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/IAO_0000136> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00000101>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Information welche die Einheit identifiziert, die verwendet wird, um die Größe einer Eigenschaft quantitativ auszudrücken."@de ,
                                                                                                     "Information which identifies the unit used to quantiatively express the magnitude of some quality."@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://doi.org/10.1351/goldbook.> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Unit_of_measurement> ,
                                                                                                                 <https://en.wikipedia.org/wiki/1> ,
                                                                                                                 "ISO/IEC Guide 99:2007" ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Einheit"@de ,
                                                                                                                         "Messeinheit"@de ,
                                                                                                                         "unit"@en ,
                                                                                                                         "unit of measurement"@en ;
                                                        rdfs:comment "This information identifies the magnitude of some entity's quality which was used as unity (i.e. the unit) in the quantification of some numeric data. For example, the \"m\" in \"3 m\" is the unit information which identifies that some entity A was used to measure the quality \"length\" of another entity B, and that entity A thereby realised the unit role in the process of measurement. For units calculated from constants or other means of derivation, we hold that there still is - at the beginning of that chain - some physical entity which bears the unit role. Multiple constants and standard values are often used in these derivations. Ideally, the entity which fulfils the unit role should be standardised."@en ,
                                                                     "Unit information should not be confused with unit, event though both are often used interchangeably. Unit information is used, for example, when expressing a measurement."@en ;
                                                        rdfs:label "Einheitsinformation"@de ,
                                                                   "unit information"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00000112
<https://purls.helmholtz-metadaten.de/hob/HDO_00000112> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000009> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0002353> ;
                                                                          owl:someValuesFrom [ owl:intersectionOf ( <https://purls.helmholtz-metadaten.de/hob/HDO_00001010>
                                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                                      owl:onProperty <http://purl.obolibrary.org/obo/RO_0002233> ;
                                                                                                                      owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00001060>
                                                                                                                    ]
                                                                                                                  ) ;
                                                                                               rdf:type owl:Class
                                                                                             ]
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Data which encode a signifier of a quantity."@en ,
                                                                                                     "Daten, die ein Zeichen einer Menge, Größe oder eines Ausmaßes kodieren."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-3949-818X> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://doi.org/10.1351/goldbook.> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Unit_of_measurement> ,
                                                                                                                 <https://en.wikipedia.org/wiki/1> ,
                                                                                                                 "ISO/IEC Guide 99:2007" ;
                                                        rdfs:comment "Quantitative data are typically expressed in numbers, but for numerical data to be considered quantitative, it must also convey the information expressed in the definition. Quantitative data are expressed by numerical data in connection with a unit."@en ;
                                                        rdfs:label "quantitative Daten"@de ,
                                                                   "quantitative data"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "quantitative Daten"@de ,
                                                                                                                "quantitative data"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://purls.helmholtz-metadaten.de/hob/HDO_00000112> ;
   owl:annotatedProperty <http://purl.org/dc/elements/1.1/contributor> ;
   owl:annotatedTarget <https://orcid.org/0000-0002-3949-818X> ;
   rdfs:comment "Jos Lehmann"
 ] .


