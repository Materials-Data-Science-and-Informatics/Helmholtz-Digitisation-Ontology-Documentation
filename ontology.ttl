                                                                   "standard"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Standards"@de ,
                                                                                                                "standards"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "Standard"@de ,
                                                                                                                "standard"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00002018
<https://purls.helmholtz-metadaten.de/hob/HDO_00002018> rdf:type owl:Class ;
