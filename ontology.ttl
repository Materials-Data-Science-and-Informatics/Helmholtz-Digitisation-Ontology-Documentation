                                                                                                                 <https://en.wikipedia.org/wiki/Authorization> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Identifikation"@de ;
                                                        rdfs:label "Autorisierung"@de ,
                                                                   "authorization"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006006
<https://purls.helmholtz-metadaten.de/hob/HDO_00006006> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001011> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000112> "identification card"@en ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process during which the potential identity of an agent is recognized."@en ,
                                                                                                     "Ein geplanter Prozess, bei dem die potenzielle Identität eines Agenten erkannt wird."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://dictionary.cambridge.org/dictionary/english/identification> ;
                                                        rdfs:comment "When a user logs into a system, he provides a user ID or user name on which basis the user is recognized and its identity is determined. This identity is authenticated based on a provided password or biometrics. Thus, identity authentication is the verification of identification."@en ;
                                                        rdfs:label "Identifizierung"@de ,
                                                                   "identification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006007
<https://purls.helmholtz-metadaten.de/hob/HDO_00006007> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A entity which realises an agent role."@en ,
                                                                                                     "Eine Entität die die Rolle eines Agents einnimmt"@de ;
                                                        rdfs:comment "For now we choose to place this as a subclass of entity as there are some classes in our hieararchy above continuant that could also be acting as agents. Once the hierarchy is clearned up, we can re-discuss and consider moving this class to continuant."@en ;
                                                        rdfs:label "Agent"@de ,
                                                                   "agent"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006008
<https://purls.helmholtz-metadaten.de/hob/HDO_00006008> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000114> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data format which (1) is open, (2) established as a standard, (3) is based on W3C recommendation (Extensible Markup Language (XML) 1.0 Fifth Edition), and (4) whose rules are published on https://www.w3.org/TR/xml/."@en ,
                                                                                                     "Ein Datenformat, das (1) offen ist, (2) als Standard etabliert ist, (3) auf der W3C-Empfehlung (Extensible Markup Language (XML) 1.0 Fifth Edition) beruht und (4) dessen Regeln auf https://www.w3.org/TR/xml/ veröffentlicht sind."@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003012> "XML" ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://www.w3.org/TR/xml/> ,
                                                                                                                 <https://aws.amazon.com/what-is/xml/> ,
                                                                                                                 <https://en.wikipedia.org/wiki/XML> ,
                                                                                                                 <https://www.w3.org/TR/xml/> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Extensible Markup Language"@de ,
                                                                                                                       "Extensible Markup Language"@en ,
                                                                                                                       "Extensible markup language Spezifikation"@de ,
                                                                                                                       "Extensible markup language specification"@en ,
                                                                                                                       "XML Spezifikation"@de ,
                                                                                                                       "XML specification"@en ;
                                                        rdfs:comment "The main purpose of XML is the serialization, i.e. storing, transmitting, and reconstructing arbitrary data in a format that is both human- and machine-readable. It is a markup language and file format."@en ;
                                                        rdfs:label "XML"@de ,
                                                                   "XML"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "Extensible Markup Language (XML) is a markup language (without predefined tags to use). It is used as a data format for storing, transmitting, and reconstructing data."@en ,
                                                                                                   "Extensible Markup Language (XML) ist eine Markup Language (ohne vordefinierte Tags zu verwenden). Sie wird als Datenformat zum Speichern, Übertragen und Rekonstruieren von Daten verwendet."@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006009
<https://purls.helmholtz-metadaten.de/hob/HDO_00006009> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000040> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A schema which is written in accordance with the XML specification."@en ,
                                                                                                     "Ein Schema, dass in Übereinstimmung mit der XML Spezifikation erstellt wurde."@de ;
                                                        <http://purl.obolibrary.org/obo/OMO_0003012> "XSD" ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/XML_Schema_(W3C)> ,
                                                                                                                 <https://www.w3.org/XML/Schema> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Extensible markup language Schema"@de ,
                                                                                                                       "Extensible markup language Schema"@en ;
                                                        rdfs:comment "This class gathers individuals that refer to specific schemas\" (can be deleted at a later stage / when in use)"@en ;
                                                        rdfs:label "XML Schema"@de ,
                                                                   "XML schema"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "A schema which specifies how the elements in an XML document are structured. Therefore, it can be used to assure that an XML document adheres to a specific structure."@en ,
                                                                                                   "Ein Schema, das angibt, wie die Elemente in einem XML-Dokument strukturiert sind. Es kann daher verwendet werden, um sicherzustellen, dass ein XML-Dokument eine bestimmte Struktur einhält."@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006010
<https://purls.helmholtz-metadaten.de/hob/HDO_00006010> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000114> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data format which (1) uses the data format JSON and, (2) adds rules published on https://json-schema.org/specification, to define schemas."@en ,
                                                                                                     "Eine Format für Daten, das (1) unter Verwendung des Datenformats JSON geschrieben ist und (2) diese Regeln um die auf https://json-schema.org/specification veröffentlichten Regeln erweitert um Schemas zu defineren."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://json-schema.org/> ;
                                                        rdfs:label "JSON Schema Spezifikation"@de ,
                                                                   "JSON Schema specification"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "A specification which enables the creation of data schemas according to JSON data format to ensure consistency, validity, and interoperability of JSON records at scale."@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006011
<https://purls.helmholtz-metadaten.de/hob/HDO_00006011> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000114> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data format which (1) is open, (2) established as a standard and (3) whose rules are published on https://yaml.org/spec/."@en ,
                                                                                                     "Ein Datenformat, das (1) offen ist, (2) als Standard etabliert ist und (3) dessen Regeln auf https://yaml.org/spec/ veröffentlicht werden."@de ;
