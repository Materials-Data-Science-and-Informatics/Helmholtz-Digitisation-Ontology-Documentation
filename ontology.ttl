###  https://purls.helmholtz-metadaten.de/hob/HDO_00002026
<https://purls.helmholtz-metadaten.de/hob/HDO_00002026> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030> ,
                                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00000025> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
