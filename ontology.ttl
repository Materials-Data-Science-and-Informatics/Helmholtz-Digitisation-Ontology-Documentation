###  https://purls.helmholtz-metadaten.de/hob/HDO_00002027
<https://purls.helmholtz-metadaten.de/hob/HDO_00002027> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000009> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Data which are open."@en ,
                                                                                                     "Daten, die offen sind."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Open_data> ;
                                                        rdfs:label "offene Daten"@de ,
                                                                   "open data"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "Data which are accessible and reusable freely and without restrictions - monetary, technical or otherwise. For this, data need to have an open license assigned and should be stored in a form and format that allows ready access and modification of the data."@en ,
                                                                                                   "Daten, die frei und ohne finanzielle, technische oder anderweitige Einschränkung zugänglich und nachnutzbar sind. Dafür muss ihnen eine freie Lizenz zugewiesen werden und die Daten sollten so strukturiert und formatiert gespeichert werden, dass der einfache Zugriff und die Änderung der Daten ermöglicht wird."@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "offene Daten"@de ,
                                                                                                                "open data"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00002028
<https://purls.helmholtz-metadaten.de/hob/HDO_00002028> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001049> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A system which comprises elements that support the functioning or the integrity of another system."@en ,
                                                                                                     "Ein System, das aus Elementen besteht, die die Funktionialität oder die Integrität eines anderen Systems unterstützt."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCIT_C80260> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Infrastructure> ,
                                                                                                                 <https://en.wiktionary.org/wiki/infrastructure> ;
                                                        rdfs:comment "Infrastructure can include basic facilities, installations, hardware, people, and services they offer. There are different types of integrity (technical etc.). There is also the relation between functionality and integrity. Systems can function compromised integrity. In that sense, integrity might be measured on a percentage scale where 0% integrity means no functionality and 100% integrity means full functionality. Because of this scale-thing, integrity is probably a BFO-quality. TODO: Check Comment, Final approval of defintion."@en ;
                                                        rdfs:label "Infrastruktur"@de ,
                                                                   "infrastructure"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Infrastrukturen"@de ,
                                                                                                                "infrastructures"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00002029
<https://purls.helmholtz-metadaten.de/hob/HDO_00002029> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00002031> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An information technology infrastructure which supports the handling of data."@en ,
                                                                                                     "Eine Informationstechnologieinfrastruktur die die Verarbeitung von Daten unterstützt."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Data_infrastructure> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Forschungsdateninfrastruktur"@de ,
                                                                                                                        "research data infrastructure"@en ;
                                                        rdfs:comment "Actions connected to the handling of data include storage, processing, sharing, retrieval, integration, consumption, etc. This term can be broadly interpreted. This could include e.g. IT infrastructure, personnel, buildings."@en ;
                                                        rdfs:label "Dateninfrastruktur"@de ,
                                                                   "data infrastructure"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Dateninfrastrukturen"@de ,
                                                                                                                "data infrastructures"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00002030
<https://purls.helmholtz-metadaten.de/hob/HDO_00002030> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00002031> ;
                                                        owl:disjointWith <https://purls.helmholtz-metadaten.de/hob/HDO_00007001> ;
