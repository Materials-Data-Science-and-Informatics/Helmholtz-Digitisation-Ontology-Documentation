###  https://purls.helmholtz-metadaten.de/hob/HDO_00001023
<https://purls.helmholtz-metadaten.de/hob/HDO_00001023> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000007> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An action specification whose concretisations direct the actions of hardware."@en ,
                                                                                                     "Eine Aktions-Spezifikation, deren Konkretisierungen die Aktionen von Hardware steuern."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Softwaresystem"@de ,
                                                                                                                       "software system"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Computer_language> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Software> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Computer Software"@de ,
                                                                                                                        "computer software"@en ,
                                                                                                                        "software component"@en ,
                                                                                                                        "software method"@en ,
                                                                                                                        "software module"@en ;
                                                        rdfs:comment "Software can be implemented in multiple computer languages. We use this as a top-level class to accommodate both ad-hoc scripts which have a more sequential nature, as well as engineered software which has a higher degree of nestedness, usually includes more formal planning and employs rigorous unit and beta testing during implementation. TODO: ongoing discussion at https://gitlab.hzdr.de/hmc/hmc/cct-7-semantics/hmc-glossary-initialization/-/merge_requests/61/diffs#82954dcd4b7d149e4f52b3a0df51f3e2cb416c4b"@en ;
                                                        rdfs:label "Software"@de ,
                                                                   "software"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "Anweisungen, die in einem Programm, Skript oder einer anderen symbolischen Form kodiert sind, und die, wenn sie ausgeführt werden, Hardware anleiten, was zu tun ist."@de ,
                                                                                                   "Instructions which are encoded in a program, script, or another symbolic form and which, when executed, tell hardware what to do."@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Software"@de ,
                                                                                                                "software"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "Software"@de ,
                                                                                                                "software"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001025
<https://purls.helmholtz-metadaten.de/hob/HDO_00001025> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000045> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A persistent unique identifier which has had its uniqueness verified against a globally authoritative registry."@en ,
                                                                                                     "Ein eindeutiger, persistenter Identifier, dessen Eindeutigkeit durch den Abgleich mit einer Registry sichergestellt wurde, die globale Autorität hat."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "persistent identifier"@en ,
                                                                                                                       "persistenter Identifier"@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://de.wikipedia.org/wiki/Persistent_Identifier> ;
                                                        rdfs:comment "This is the ideal PID to realize FAIRness. In general, it is expected that - once created - a persistent unique identifier will be stored in the globally authoritative registry it is verified against. The registry will then prevent duplication of the persistent unique identifier as new identifiers are added. "@en ;
                                                        rdfs:label "persistent globally unique identifier"@en ,
                                                                   "persistenter global eindeutiger Identifier"@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "persistent globally unique identifiers"@en ,
                                                                                                                "persistente global eindeutige Identifier"@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001027
<https://purls.helmholtz-metadaten.de/hob/HDO_00001027> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A quality which inheres in data, by virtue of that data having the dispositions of findability, accessibility, interoperability and re-usability according to the FAIR principles. "@en ,
                                                                                                     "Eine Eigenschaft, die Daten haben, wenn sie die Veranlagungen zur Auffindbarkeit, Zugänglichkeit, Interoperabilität und Wiederverwendbarkeit gemäß den FAIR-Prinzipien aufweisen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "FAIR"@de ,
                                                                                                                       "FAIR"@en ,
                                                                                                                       "FAIRness von Daten"@de ,
                                                                                                                       "data FAIRness"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "FAIRness von Metadaten"@de ,
                                                                                                                        "metadata FAIRness"@en ;
                                                        rdfs:comment "We note that, an absolute measure for FAIRness is not possible. This is because FAIRness will always depend on specific application cases or operational environments. The FAIR Principles are, after all, high-level principles. Several projects have implemented quantitative and semi-quantitative measures of FAIRness, but these measures also require specific implementations and/or interpretations of the FAIR Principles. While some aspects of the FAIR principles can be measured in absolute terms (i.e. is there a PID?) others (i.e. is the metadata rich?) require advanced foreknowledge of a representative sample of possible application cases."@en ;
                                                        rdfs:label "FAIRness"@de ,
                                                                   "FAIRness"@en ;
                                                        rdfs:seeAlso "https://ardc.edu.au/resources/aboutdata/fair-data/fair-self-assessment-tool/" ,
                                                                     "https://fairaware.dans.knaw.nl/" ,
                                                                     "https://www.biorxiv.org/content/10.1101/225490v3.full.pdf" ,
                                                                     "https://www.fairsfair.eu/f-uji-automated-fair-data-assessment-tool" ,
                                                                     "https://www.go-fair.org/fair-principles/" ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "Die Eigenschaft von Daten, wenn sie entsprechend der FAIR-Prinzipien auffindbar, zugänglich, interoperabel und wiederverwendbar sind."@de ,
                                                                                                   "The property of data, if they are findable, accessible, interoperable and re-usable according to the FAIR principles. "@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001029
<https://purls.helmholtz-metadaten.de/hob/HDO_00001029> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A quality which inheres in data, by virtue of that data being sufficiently informative to support the completion of one or more planned processes."@en ,
                                                                                                     "Eine Eigenschaft die Daten haben, wenn sie ausreichend informativ für die Durchführung eines, oder mehrerer, definierter geplanter Prozesse sind."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Reichhaltigkeit von Daten"@de ,
                                                                                                                       "data richness"@en ,
                                                                                                                       "reich"@de ,
                                                                                                                       "rich"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Reichhaltigkeit von Metadaten"@de ,
                                                                                                                        "metadata richness"@en ;
                                                        rdfs:comment "The term \"rich metadata\" is often used loosely, e.g. in the descriptions of the FAIR (sub)principles. We note that the \"richness\" of metadata is depending on the aims, criteria, and capabilities of the agents that would use it. As such, metadata can only be labelled as \"rich\" when the complete (or at least a representative) set of use cases, it will be subject to, is known - along with their specifications. Even in the latter case, new (re)uses of the metadata, unknown at the time at which metadata is generated or gathered, can easily arise. Thus it is generally recommended to gather and record all feasible metadata as much as possible. These metadata may cover contextual factors, data structure, administrative aspects, provenance, or/and the results of analyses performed upon the metadata or its associated data. We note that in the case of the FAIR (sub)principles, the richness of metadata is specifically required to realise the findability and reusability or related data. Being informative is a quantitative measurable attribute. Please refer to the definition of information in this glossary for further information."@en ;
                                                        rdfs:label "Reichhaltigkeit"@de ,
                                                                   "richness"@en ;
                                                        rdfs:seeAlso "https://www.go-fair.org/fair-principles/" .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001030
<https://purls.helmholtz-metadaten.de/hob/HDO_00001030> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000002> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A classification system which is used to hierarchically categorise semantic artefacts according to their semantic expressiveness."@en ,
                                                                                                     "Ein Klassifizierungssystem, das zur hierarchischen Einordnung semantischer Artefakte auf Basis ihrer semantischen Ausdrucksfähigkeit verwendet wird."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://inmyownterms.com/is-this-a-glossary-a-lexicon-or-a-thesaurus-how-to-tell-them-apart/> ;
                                                        rdfs:comment "Most common semantic resources that are put into relation in this context are (in increasing grade of semantic expressiveness) Glossaries, Taxonomies, Thesauri, Topic Maps, and Ontologies."@en ;
                                                        rdfs:label "semantic ladder"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "semantic ladder"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001031
<https://purls.helmholtz-metadaten.de/hob/HDO_00001031> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A quality which inheres in an semantic artefact by virtue of its ability to encode the meaning of data in a form that is accessible to humans and/or machines and allows inference."@en ,
                                                                                                     "Eine Eigenschaft, die ein semantischer Artefakt hat, wenn sie Wissen speichern und in einer Form darstellen kann, die für menschliche und/oder maschinelle Akteure zugänglich ist."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Semantic_property.> ;
                                                        rdfs:comment "The minimum level of semantic expressiveness depends on whether the entity is to be used by human or machine agents. For a human, a simple controlled list of terms can be regarded as a semantic entity as the knowledge possessed by the human can react to and reason over it. However, it would not be, by itself, a semantic entity for a machine agent, which only processes it as strings of data. Machine agents would need some form of structure to establish logically consistent relationships between classes such as synonymy, antonymy, hyponymy, and hypernymy. This can be further increased by adding axiomatic relationships with domain and range constraints suitable for machine reasoning. Semantic artifacts include but are not limited to digital glossaries, thesauri, taxonomies and ontologies."@en ;
                                                        rdfs:label "semantic expressiveness"@en ,
                                                                   "semantische Ausdruckskraft"@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "semantic expressiveness"@en ,
                                                                                                                "semantische Ausdruckskraft"@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001032
<https://purls.helmholtz-metadaten.de/hob/HDO_00001032> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007031> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A list which contains exactly two elements in a fixed order."@en ,
                                                                                                     "Ein Objekt, welches genau zwei Elemente enthält, die eine feste Abfolge haben."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wiktionary.org/wiki/ordered_pair> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "2-tuples"@en ;
                                                        rdfs:comment "Exchanging one or both elements or changing the order would result in a different object."@en ;
                                                        rdfs:label "geordnetes Paar"@de ,
                                                                   "ordered pair"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "geordnete Paare"@de ,
                                                                                                                "ordered pairs"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "geordnetes Paar"@de ,
                                                                                                                "ordered pair"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001033
<https://purls.helmholtz-metadaten.de/hob/HDO_00001033> rdf:type owl:Class ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An abstract representation of an entity which (1) is based on a substantial collection of information, (2) grants its bearer reliable familiarity with that entity, and (3) can be used to reason and take action about that entity."@en ,
                                                                                                     "Eine abstrakte Abbildung einer Entität, die (1) aus umfangreichen Informationen aufgebaut ist, (2) ihrem Träger eine zuverlässige Vertrautheit mit dieser Entität gewährt und (3) dazu verwendet werden kann, Überlegungen und Schlussfolgerungen über die Entität zu ziehen und diesbezüglich zu handeln."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wiktionary.org/wiki/knowledge> ;
                                                        rdfs:comment "For example, an expert with knowledge about the salinity range of the Arctic Ocean (constructed from large amounts of information on the topic would be able to reason that a salinity value of 43% is a likely error, rather than a real measurement. We note that the term 'abstract representation' used in this definition should not be confused with the term 'knowledge representation' that is used in the field of artificial intelligence and computer reasoning and typically is a formalised form of knowledge. "@en ;
                                                        rdfs:label "Wissen"@de ,
                                                                   "knowledge"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001034
<https://purls.helmholtz-metadaten.de/hob/HDO_00001034> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001033> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Knowledge, which has been encoded in a machine-readable and actionable form."@en ,
                                                                                                     "Wissen, das in für Maschinen lesbarer und verwendbarer Form codiert wurde. "@de ;
                                                        rdfs:label "digital knowledge"@en ,
                                                                   "digitales Wissen"@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001035
<https://purls.helmholtz-metadaten.de/hob/HDO_00001035> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A quality which inheres in data, by virtue of (1) the absence of restrictions - monetary, technical, or otherwise - upon their use, (2) the data being hosted in a repository which allows, in whole or in part, the free access to them, (3) the data containing all information required for license compliance, and (4) the data being serialised in such a way as to readily allow identification of, access to, and modification of their parts."@en ,
                                                                                                     "Eine Eigenschaft, die Daten haben, wenn (1) ihre Nutzung keinen monetären, technischen oder sonstigen Beschränkungen unterliegt, (2) sie in einem Repositorium gehostet werden, das den freien Download der Daten, bzw. Teile dieser über das Internet ermöglicht, (3) die Daten alle für die Einhaltung der Lizenzbestimmungen erforderlichen Informationen enthalten und (4) Zugang zu sowie Änderungen einzelner Komponenten dieser Daten einfach möglich ist."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Offenheit von Metadaten"@de ,
                                                                                                                        "metadata openness"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Offenheit"@de ,
                                                                                                                         "open"@en ,
                                                                                                                         "openness"@en ;
                                                        rdfs:comment "We might need a separate definition for \"open\" that also applies to entities like software (could be data) and license (or \"license openness\"). We note that the term \"open\" is used in various fields with differing meanings. While the given definition here is applicable to terms, such as open data (for research data) or open-source software (for program code), it should be differentiated from the meaning of the term open access (in publishing). The latter has fewer constraints with respect to e.g., hosting, format and re-use. The absence of legal restriction for re-use can be ensured by making sure that the data or software in question as well as the format it is stored in are under a license specifying permission to re-use and modify, such as e.g. CC-BY. The requirements to cite the source are not seen as a restriction on re-use or modification in the sense of the given definition here. Covering reasonable one-time reproduction costs (e.g., fees to cover the costs when ordering a physical medium containing the requested data or software) is not seen as a monetary restriction in the sense of this definition. "@en ;
                                                        rdfs:label "Offenheit von Daten"@de ,
                                                                   "data openness"@en ;
                                                        rdfs:seeAlso "https://en.wikipedia.org/wiki/Open_source" ,
                                                                     "https://opendefinition.org/od/2.1/en/" .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001036
<https://purls.helmholtz-metadaten.de/hob/HDO_00001036> rdf:type owl:Class ;
                                                        owl:equivalentClass <https://purls.helmholtz-metadaten.de/hob/HDO_00006084> ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000040> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A schema which represents or constitutes the structure of metadata."@en ,
                                                                                                     "Ein Schema, dass die Struktur von Metadaten beschreibt."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.sciencedirect.com/topics/computer-science/metadata-schema> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "information proile" ;
                                                        rdfs:comment "A metadata schema is used to (pre-)define the structure of metadata. For example, the arrangement of fields in a BibTex template constitutes a metadata schema to be used by a reference management system. Note that the term \"metadata standard\" is not a exact synonym of \"metadata schema\", even though these terms are often used interchangeably. Not all schemata are standardised and not all metadata standards are schemata, however one could have a standard metadata schema. "@en ;
                                                        rdfs:label "Metadatenschema"@de ,
                                                                   "metadata schema"@en ;
                                                        rdfs:seeAlso <https://purls.helmholtz-metadaten.de/hob/HDO_00001036> ,
                                                                     "https://ddialliance.org/Specification/DDI-Codebook/2.5/" ,
                                                                     "https://www.dublincore.org/" ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "A template which shows how metadata is to be structured and stored. "@en ,
                                                                                                   "Eine Vorlage, die zeigt, wie Metadaten strukturiert und gespeichert werden sollten. "@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Metadatenschemas"@de ,
                                                                                                                "Metadatenschemata"@de ,
                                                                                                                "Metadatenschemen"@de ,
                                                                                                                "metadata schemas"@en ,
                                                                                                                "metadata schemata"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "Metadatenschema"@de ,
                                                                                                                "metadata schema"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001037
<https://purls.helmholtz-metadaten.de/hob/HDO_00001037> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00000009>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A generically dependent continuant which is composed always of multiple data instances, which are grouped intentionally according to one or more common characteristics."@en ,
                                                                                                     "Ein generisch abhängiges Kontinuum, welches immer aus mehreren Daten besteht, die aufgrund einer oder mehrerer gemeinsamer Merkmale mit Absicht zusammengestellt wurden."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-3949-818X> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCIT_C47824> ,
                                                                                                                 <https://de.wikipedia.org/wiki/Datenbasis> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "dataset"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Datenbasis"@de ;
                                                        rdfs:comment "Intention may be related to analysis, storage or publication of that data(set). For example, all files that are stored together on one CD-ROM or DVD might constitute a dataset as they are stored physically together. The organisation of the collection might strongly differ between application cases."@en ;
                                                        rdfs:label "Datensatz"@de ,
                                                                   "data set"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Datensätze"@de ,
                                                                                                                "data sets"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "Datensatz"@de ,
                                                                                                                "data set"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://purls.helmholtz-metadaten.de/hob/HDO_00001037> ;
