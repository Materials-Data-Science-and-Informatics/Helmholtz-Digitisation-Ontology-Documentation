###  https://purls.helmholtz-metadaten.de/hob/HDO_00001001
<https://purls.helmholtz-metadaten.de/hob/HDO_00001001> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000033> ,
                                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001005> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A specification which describes how to create or modify some entity such that it resembles the standard for a set or a type, allowing it to be considered a member of that set or type."@en ,
                                                                                                     "Eine Spezifikation, die beschreibt, wie eine Entität erstellt oder verändert werden muss, um einem Standard einer Menge oder eines Typs zu entsprechen und somit als Mitglied dieser angesehen zu werden."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Standard"@de ,
                                                                                                                         "standard"@en ;
                                                        rdfs:comment "Different types of standards can be discriminated based on how they came to be, i.e. either through community wide adoption or through sanctioned actions of a legal authority."@en ;
                                                        rdfs:label "Standardspezifikation"@de ,
                                                                   "standard specification"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Standardspezifikationen"@de ,
                                                                                                                "standard specifications"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "Standardspezifikation"@de ,
                                                                                                                "standard specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001002
<https://purls.helmholtz-metadaten.de/hob/HDO_00001002> rdf:type owl:Class ;
