                                                        rdfs:label "Information"@de ,
                                                                   "information"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "Any sign, symbol, or data which reduces uncertainty about the existence, identity, or properties of (i.e. provides information about) an entity. Information is assumed to be accurate - inaccurate representation would be considered misinformation."@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Informationen"@de ,
                                                                                                                "information"@en .

