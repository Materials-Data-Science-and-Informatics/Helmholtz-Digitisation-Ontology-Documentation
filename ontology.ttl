                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Structured data which contains at least one field."@en ,
                                                                                                     "Strukturierte Daten, die aus mindestens einem Feld bestehen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Record_(computer_science)> ,
                                                                                                                 <https://www.wikidata.org/wiki/Q2470517> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Register"@de ,
                                                                                                                        "Registratur"@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "compound data"@en ,
                                                                                                                         "struct"@en ,
                                                                                                                         "structure"@en ;
