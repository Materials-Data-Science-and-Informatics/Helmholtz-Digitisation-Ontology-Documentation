                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://doi.org/10.1038/sdata.2016.18> ;
                                                        rdfs:comment "See definitions of findability, accessibility, interoperability, and reusability."@en ;
                                                        rdfs:label "FAIR data"@en ,
                                                                   "FAIRe Daten"@de ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "FAIRe Daten"@de ,
                                                                                                                "FAIR data" .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00002014
<https://purls.helmholtz-metadaten.de/hob/HDO_00002014> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001017> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A digital system which, when processing data, is capable of realising - simultaneously or separately - the dispositions of findability, accessibility, interoperability, and reusability as specified in the FAIR Principles."@en ,
                                                                                                     "Ein digitales System, das bei der Verarbeitung von Daten - gleichzeitig oder nacheinander - die Merkmale der Auffindbarkeit, Zugänglichkeit, Interoperabilität und der Wiederverwendbarkeit, so wie sie in denn FAIR Prinzipien spezifiziert sind, erfüllen kann."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://doi.org/10.1038/sdata.2016.18> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "FAIRes digitales System"@de ;
                                                        rdfs:comment "See definitions of findability, accessibility, interoperability, and reusability."@en ;
                                                        rdfs:label "FAIR digital system"@en ,
                                                                   "FAIR digitales System"@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00002015
<https://purls.helmholtz-metadaten.de/hob/HDO_00002015> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
