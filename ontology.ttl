###  https://purls.helmholtz-metadaten.de/hob/HDO_00002016
<https://purls.helmholtz-metadaten.de/hob/HDO_00002016> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000428> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An entity which is used as a reference, model, or example to determine membership in a set or a type."@en ,
                                                                                                     "Eine Entität, die als Muster, Referenz oder Beispiel verwendet wird, um die Zugehörigkeit zu einer Menge oder einem Typ festzulegen."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-2209-9385> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.merriam-webster.com/dictionary/standard> ;
                                                        rdfs:comment "An entity which serves as a standard for a type also meets the criteria in a standard specification for that type. A standard could be a metadata schema, a mapping/crosswalk, a data set, a model, a technical part etc."@en ;
