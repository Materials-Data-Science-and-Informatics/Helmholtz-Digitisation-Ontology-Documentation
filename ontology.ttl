###  https://purls.helmholtz-metadaten.de/hob/HDO_00001070
<https://purls.helmholtz-metadaten.de/hob/HDO_00001070> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001059> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A quantification process during which the quantified signifier of a quality stems from an independent continuant."@de ,
                                                                                                     "Ein Quantifizierungsprozess, bei dem der zu quantifizierte Signifier einer Qualität von einem Independent Continuant abhängt."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Messung"@de ,
                                                                                                                       "measurement"@en ;
                                                        rdfs:comment "This class is created to differentiate quantification processes in real-world (= physical) entities that can be measured (i.e. with a tape measure, versus these quantification processes that happen during calculations or computational modelling. Independent continuants  encompass material entities (e.g. physical objects) as well as immaterial entities (e.g. the border of a country)."@en ;
                                                        rdfs:label "Messprozess"@de ,
                                                                   "measurement process"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00001071
<https://purls.helmholtz-metadaten.de/hob/HDO_00001071> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000112> ;
                                                        rdfs:comment "This class is created to be able to discriminate data originating from computational models (HDO_00001069) from those that comes from measurements and experimentation (this class)."@en ;
                                                        rdfs:label "Messdaten"@de ,
                                                                   "measurement data"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Messdaten"@de ,
                                                                                                                "Quantitative data which are the output of a measurement process."@en ,
                                                                                                                "measurement data"@en .


