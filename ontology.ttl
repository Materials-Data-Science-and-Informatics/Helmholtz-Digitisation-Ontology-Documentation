                                                        rdfs:label "obsolete Zeichen einer Eigenschaft"@de ,
                                                                   "obsolete signifier of a quality"@en ;
                                                        owl:deprecated "true"^^xsd:boolean .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007025
<https://purls.helmholtz-metadaten.de/hob/HDO_00007025> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000033> ,
                                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001005> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A specification which pertains to the structuredness of one or more data sets."@en ,
                                                                                                     "Eine Spezifikation, die die Strukturiertheit von ein oder mehreren Datensätzen betrifft."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://edamontology.org/format_1915> ,
                                                                                                                 <http://purl.obolibrary.org/obo/NCIT_C42761> ,
                                                                                                                 <https://dictionary.cambridge.org/dictionary/english/structure> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Abstract_data_type> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Data_format> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Data_structure> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Structure> ,
                                                                                                                 <https://www.collinsdictionary.com/dictionary/english/structure> ,
                                                                                                                 <https://www.duden.de/rechtschreibung/Struktur> ,
                                                                                                                 <https://www.merriam-webster.com/dictionary/structure> ,
                                                                                                                 <https://www.merriam-webster.com/dictionary/data%20structure> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Datenstruktur"@de ,
                                                                                                                       "Datenstrukturspezifikation"@de ,
                                                                                                                       "data structure"@en ;
                                                        rdfs:comment "The data structure specificaiton defines how parts or components of a data set are arranged and relate to each other. It does not comprise information regarding the syntax that data is represented in (data format) or the serialization of how that data is stored within a system (file format)."@en ;
                                                        rdfs:label "Datenstrukturspezifikation"@de ,
                                                                   "data structure specification"@en ;
                                                        rdfs:seeAlso <https://purls.helmholtz-metadaten.de/hob/HDO_00000005> .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007026
<https://purls.helmholtz-metadaten.de/hob/HDO_00007026> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007025> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data structure specification which requires a data set to consist of a sequence of elements."@en ,
                                                                                                     "Eine Datenstrukturspezifikation, die verlangt, dass ein Datensatz aus einer Folge von Elementen besteht."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Liste"@de ,
                                                                                                                         "list"@en ;
                                                        rdfs:label "Listenspezifikation"@de ,
                                                                   "list specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007027
<https://purls.helmholtz-metadaten.de/hob/HDO_00007027> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007025> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data structure specification which requires some data to consist of two elements, the first of which realizes a key role in order to find and access the other element which is a value."@en ,
                                                                                                     "Eine Datenstruktursprezifikation, die verlangt, dass Datenpaar aus zwei Elementen bestehen, von denen das erste eine Schlüsselrolle einnimmt, um das andere Element, welches einen Wert ist, zu finden und darauf zuzugreifen."@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Feldspezifikation"@de ,
                                                                                                                       "field specification"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Schlüssel-Wert Paar"@de ,
                                                                                                                         "key-value pair"@en ;
                                                        rdfs:label "Schlüssel-Wert Paar Spezifikation"@de ,
                                                                   "key-value pair specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007028
<https://purls.helmholtz-metadaten.de/hob/HDO_00007028> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007025> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data structure specification which requires some data to consist of a set of key-value pairs with unique keys."@en ,
                                                                                                     "Eine Datenstrukturspezifikation, die erfordert, dass Daten aus einer Menge von Schlüssel-Wert-Paaren mit eindeutigen Schlüsseln besteht."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://computersciencewiki.org/index.php/Dictionaries> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Associative_array> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Object_(computer_science)> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Mapspezifikation"@de ,
                                                                                                                       "map specification"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Objektspezifikation"@de ,
                                                                                                                         "mapping"@en ,
                                                                                                                         "object specification"@en ;
                                                        rdfs:label "dictionary specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007029
<https://purls.helmholtz-metadaten.de/hob/HDO_00007029> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007025> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data structure specification which requires some data to consist of at least two elements, known as points or nodes, that are related with one another via relations, known as edges or links."@en ,
                                                                                                     "Eine Datenstrukturspezifikation, die erfordert, dass Daten aus mindestens zwei Elementen, bekannt als Punkte oder Knoten, bestehen, die durch Beziehungen, bekannt als Kanten oder Verbindungen, miteinander verbunden sind."@de ;
                                                        rdfs:label "Graphspezifikation"@de ,
                                                                   "graph specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007031
<https://purls.helmholtz-metadaten.de/hob/HDO_00007031> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001037> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Structured data which has structuredness conforming to a list specification."@en ,
                                                                                                     "Strukturierte Daten, deren Strukturiertheit einer Listenspezifikation folgt."@de ;
                                                        rdfs:label "Liste"@de ,
                                                                   "list"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007032
<https://purls.helmholtz-metadaten.de/hob/HDO_00007032> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00006028> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Structured data which has structuredness conforming to a dictionary specification."@en ,
                                                                                                     "Strukturierte Daten, deren Strukturiertheit einer Wörterbuchspezifikation enspricht."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Associative_array> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Object_(computer_science)> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "map (computer science)"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "object (computer science)"@en ;
                                                        rdfs:label "dictionary"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007033
<https://purls.helmholtz-metadaten.de/hob/HDO_00007033> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007029> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A graph specification which requires the edges in a graph to be directed edges."@en ,
                                                                                                     "Eine Graphenspezifikation, die erfordert, dass die Kanten in einem Graphen gerichtet sind."@de ;
                                                        rdfs:label "directed graph specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007034
<https://purls.helmholtz-metadaten.de/hob/HDO_00007034> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007033> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A directed graph specification which requires a directed graph data set to not contain any graphical cycles which consist of edges of the same type."@en ,
                                                                                                     "Eine Spezifikation für gerichtete Graphen, die erfordert, dass in einem Graphen keine zyklischen Strukturen mit Verbindungen des selben Typs gebildet werden dürfen."@de ;
                                                        rdfs:label "directed acyclic graph specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007035
<https://purls.helmholtz-metadaten.de/hob/HDO_00007035> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007034> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A directed acyclic graph specification which requires a directed acyclic graph to be (1) used to represent knowledge about entities (represented as nodes) by relating them to one another with formalised logical relations (represented as edges), (2) logically coherent, such that it can be reasoned over and used for inference by machine agents and (3) constructed such that nodes further along in a path inherit all the semantic properties of their antecedents."@en ,
                                                                                                     "Eine Spezifikation zu gerichteten, azyklischen Graphen, die von solchen Graphen fordert, dass sie (1) dazu verwendet werden, Wissen über Objekte zu veranschaulichen, indem die Entitäten (repräsentiert als Knoten) mit formalisierte logische Beziehungen (repräsentiert als Kanten) verbunden werden, (2) logisch kohärent sind, so dass sie von maschinellen Agenten für Begründungen und Schlussfolgerung verwendet werden können und (3) so aufgebaut sind, dass entlang eines Pfades alle Knoten die semantischen Eigenschaften der zuvor besuchten Knoten erben."@de ;
                                                        rdfs:label "ontological graph specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007036
<https://purls.helmholtz-metadaten.de/hob/HDO_00007036> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007029> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A graph specification which requires a graph to use machine-actionable semantic technology to (1) describe its elements and their instances and (2) qualify the relations between them."@en ,
                                                                                                     "Eine Graphspezifikation, für deren Erfüllung ein Graph maschinell verarbeitbare semantische Technologie verwenden muss, um (1) seine Elemente und deren Instanzen zu beschreiben und (2) die Beziehungen zwischen ihnen zu qualifizieren."@de ;
                                                        rdfs:comment "A network of real-world entities — i.e. objects, events, situations, or concepts — and the relationship between them. The content of the KG is typically human- and machine-readable. The Google Knowledge Graph is an example of a large-scale knowledge graph used by Google and its services to enhance its search engine's results."@en ;
                                                        rdfs:label "Wissensgraphspezifikation"@de ,
                                                                   "knowledge graph specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007037
<https://purls.helmholtz-metadaten.de/hob/HDO_00007037> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007025> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data structure specification which requires a data set to be (1) collected in a centralised manner and (2) organized in a consistent structure."@en ,
                                                                                                     "Eine Datenstrukturspezifikation, die verlangt, dass Daten (1) zentral gesammelt und (2) in einer einheitlichen Struktur organisiert wurden."@de ;
                                                        rdfs:comment "Because of the close relationship between them, the term \"database\" is often used casually to refer to both a database and the database management system used to manipulate it. Here, we use the term to refer to any organised collection of data that forms the basis of some activity and the term \"database system\" to describe the combination of a database and a database management system. It is generally assumed that the organisation of data in a database will enhance efficiency of operations such as search, retrieval, update, and auditing. These actions are usually performed through a database management system."@en ;
                                                        rdfs:label "database specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007038
<https://purls.helmholtz-metadaten.de/hob/HDO_00007038> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007025> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data structure specification which requires a data set to minimally contain (1) subject data, (2) metadata about that subject data, and (3) a globally unique identifier which, when dereferenced, allows an agent to access the data set itself."@en ,
                                                                                                     "Eine Datenstrukturspezifikation, die vorschreibt, dass ein Datensatz mindestens (1) Subjektdaten, (2) Metadaten über diese Subjektdaten und (3) einen global eindeutigen Identifier enthält, der, wenn er dereferenziert wird, Zugriff auf den Datensatz selbst ermöglicht."@de ;
                                                        rdfs:label "digital object specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007039
<https://purls.helmholtz-metadaten.de/hob/HDO_00007039> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007025> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A data structure specification which requires a data set to encode a hierarchy of entities by using a consistent set of principles of relatedness."@en ,
                                                                                                     "Eine Datenstrukturspezifikation für deren Einhaltung die Entitäten in einem Datensatz hierarchisch angeordnet sein müssen, unter Verwendung eines einheitlichen Prinzips der Verbundenheit."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "taxonomy"@de ;
                                                        rdfs:comment "A hierarchical arrangement of entities based on how similar they are to one another. Entities deeper in the hierarchy need to retain all the properties of their ancestors. Terminologies can also be structured as a taxonomy."@en ,
                                                                     "Eine hierarchische Anordnung von Entitäten, basierend auf ihrer Ähnlichkeit untereinander. Entitäten auf niedrigeren Hierarchieebenen müssen alle Eigenschaften der ihnen in direkter Linie übergeordneten Entitäten übernehmen. Terminologien können auch als Taxonomie strukturiert sein."@de ;
                                                        rdfs:label "taxonomy specification"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007040
<https://purls.helmholtz-metadaten.de/hob/HDO_00007040> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001011> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0000057> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00001005>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process during which it is determined whether the type or properties of an entity conform to a specification."@en ,
                                                                                                     "Ein geplanter Prozess, bei dem festgestellt wird, ob der Typ oder die Eigenschaften einer Entität mit einer Spezifikation übereinstimmen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Überprüfung"@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://blog.golayer.io/business/data-validation> ,
                                                                                                                 <https://dictionary.cambridge.org/dictionary/english/validation> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Data_validation> ,
                                                                                                                 <https://www.nasa.gov/seh/5-4-product-validation> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Konformitätsüberprüfung"@de ,
                                                                                                                       "Validation"@de ,
                                                                                                                       "validation process"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Daten Validierung"@de ,
                                                                                                                        "data validation"@en ;
                                                        rdfs:comment """In the context of this ontologies most types of validation will pertain to data. Some other types of validation might pertain to scientific equipment or samples however. For now we intended to keep the hierarchy light and therefore did not include a specific \"data validation\" class which we might consider in the future if instances in this class get too heterogeneous. 
Data validation is a critical aspect of data management. It ensures that data entered into a system is accurate, consistent, and meets the standards set for that specific system. A failed validation (e.g. of a metadata record against a metadata schema) would render the entity invalid and consequently it would not be a member of the validated set of entities."""@en ;
                                                        rdfs:label "Validierung"@de ,
                                                                   "validation"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007041
<https://purls.helmholtz-metadaten.de/hob/HDO_00007041> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007040> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://purl.obolibrary.org/obo/RO_0000057> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00001036>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A validation during which it is determined whether some metadata record conforms to some metadata schema."@en ,
                                                                                                     "Eine Validierung, bei der festgestellt wird, ob ein Metadatensatz einem Metadatenschema entspricht."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Metadatenüberprüfung"@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "metadata record validation"@en ;
                                                        rdfs:label "Metadatenvalidierung"@de ,
                                                                   "metadata validation"@en ;
                                                        rdfs:seeAlso <https://purls.helmholtz-metadaten.de/hob/HDO_00001036> .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007042
<https://purls.helmholtz-metadaten.de/hob/HDO_00007042> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007040> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A validation during which it is determined whether some data conforms to some data type."@en ,
                                                                                                     "Eine Validierung, bei der festgestellt wird, ob bestimmte Daten einem bestimmten Datentyp entsprechen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Datentypüberprüfung"@de ;
                                                        rdfs:comment "Data type validation is typically used in programming where it is assessed whether some data conforms to e.g. the rules of the data type string, boolean, list, integer or else."@en ;
                                                        rdfs:label "Datentypvalidierung"@de ,
                                                                   "data type validation"@en ;
                                                        rdfs:seeAlso <https://purls.helmholtz-metadaten.de/hob/HDO_00000007> .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007043
<https://purls.helmholtz-metadaten.de/hob/HDO_00007043> rdf:type owl:Class ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "OBSOLETE A validation during which it is determined whether some data conforms to some rules."@en ;
                                                        rdfs:comment "The rules involved in data validation can concern various aspects, e.g. correctness or structure."@en ,
                                                                     "to be depricated"@en ,
                                                                     "adding 'data validation' as a class was discussed during the development of HDO v 1.0. We decided to deprecate the class for now, in order to wait and see if various types of validations end up being instantiated in the class 'validation'. Should that be the case we would reconsider refining the hierarchy and adding 'data validation' as a sub-class of validation." ;
                                                        rdfs:label "obsolete data validation"@en ;
                                                        owl:deprecated "true"^^xsd:boolean .


###  https://purls.helmholtz-metadaten.de/hob/HDO_10000047
<https://purls.helmholtz-metadaten.de/hob/HDO_10000047> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A role which inheres in an entity and is realized when the magnitude of at least one of its qualities is used as a reference to express the magnitude of the same quality or qualities in other entities."@en ,
                                                                                                     "Eine Rolle, die einer Entität innewohnt und realisiert wird, wenn die Größe mindestens einer ihrer Eigenschaften als Referenz verwendet wird, um die Größe der gleichen Eigenschaft oder Eigenschaften anderer Entitäten auszudrücken."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://www.ontology-of-units-of-measure.org/resource/om-2/Unit> ,
                                                                                                                 <https://doi.org/10.1351/goldbook> ,
                                                                                                                 <https://en.wikipedia.org/wiki/Unit_of_measurement> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "unit of measurement role"@en ;
                                                        rdfs:comment "The quality in this definition refers to physical qualities such as length, duration, weight. If qualities can be related they are neccessarily of the same physical dimension. If a unit role is realised in a process of measurement, the unit is a  unit of measurement."@en ;
                                                        rdfs:label "Einheitsrolle"@de ,
                                                                   "unit role"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "unit roles"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001026> "unit role"@en .


###  https://purls.helmholtz-metadaten.de/hob/hdo.owl#triple_specification
:triple_specification rdf:type owl:Class ;
                      rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007025> ;
                      <http://purl.obolibrary.org/obo/IAO_0000115> "A data structure specification which requires structured data to consist of three elements, that describe an entities (the subject) relation (the predicate) with another entity (the object) in a fixed order."@en ,
                                                                   "Eine Datenstrukturspezifikation, die vorschreibt, dass strukturierte Daten aus drei Elementen bestehen müssen, die die Beziehung (Prädikat) zwischen einer Entität (Subjekt) und einer anderen Entität (Objekt) in einer festen Reihenfolge beschreiben."@de ;
                      rdfs:comment "We note that a triple consist of a fixed order that is subject-predicate-object."@en ;
                      rdfs:label "Tripel Spezifikation"@de ,
                                 "triple specification"@en .


