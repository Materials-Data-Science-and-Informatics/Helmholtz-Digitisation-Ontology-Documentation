###  https://purls.helmholtz-metadaten.de/hob/HDO_00006026
<https://purls.helmholtz-metadaten.de/hob/HDO_00006026> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A role which inheres in a continuant and is realised when this continuant increases the efficiency of a planned process or extend its range of effect."@en ,
                                                                                                     "Eine Rolle, die einem Continuant innewohnt und realisiert wird, wenn dieses Continuant die Effizienz eines geplanten Prozesses erhöht oder dessen Wirkungsbereich erweitert."@de ;
                                                        rdfs:label "tool role"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006027
<https://purls.helmholtz-metadaten.de/hob/HDO_00006027> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001033> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Knowledge which pertains to an entity and relates it to a glyph, string or other representational entity in order to refer to it."@en ,
                                                                                                     "Wissen, das sich auf eine Entität bezieht und sie mit einer Glyphe, einer Zeichenkette oder einer anderen repräsentativen Entität in Verbindung bringt, um auf sie zu verweisen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://www.merriam-webster.com/dictionary/meaning> ,
                                                                                                                 <https://www.merriam-webster.com/dictionary/semantics> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Meaning"@en ;
                                                        rdfs:comment "Unambiguous semantics are achieved \"in use\" or through established context. This can be the use of a word within a sentence where that word is given context by the grammar and other words in that sentence. That may also be by using formalising relations in \"semantic artefacts\" such as ontologies, which use glyphs or string to label classes and establish relations between one another."@en ;
                                                        rdfs:label "Semantik"@de ,
                                                                   "semantics"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006028
<https://purls.helmholtz-metadaten.de/hob/HDO_00006028> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000005> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Structured data which encodes semantic relations between entities."@en ,
                                                                                                     "Strukturierte Daten, die semantische Beziehungen zwischen Entitäten kodieren."@de ;
                                                        rdfs:comment "The encoded relations might be between entities which are represented by words or glyps."@en ;
                                                        rdfs:label "semantic artefact"@en ,
                                                                   "semantischer Artefakt"@de .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006029
<https://purls.helmholtz-metadaten.de/hob/HDO_00006029> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001013> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Technologie, die die Kodierung und den Austausch von semantischen Beziehungen ermöglicht."@de ,
                                                                                                     "Technology which enables the encoding and exchange of semantic relations."@en ;
                                                        rdfs:label "Semantische Technologien"@de ,
                                                                   "semantic technology"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006030
<https://purls.helmholtz-metadaten.de/hob/HDO_00006030> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <https://purls.helmholtz-metadaten.de/hob/HDO_00006036> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00006031>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An entity which realises a data storage role."@en ,
                                                                                                     "Eine Entität, die eine Datenspeicher-Rolle realisiert."@de ;
                                                        rdfs:label "Datenspeicher"@de ,
                                                                   "data store"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006031
<https://purls.helmholtz-metadaten.de/hob/HDO_00006031> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A role which inheres in an entity and is realised when this entity retains a concretization of data on hardware over time in a planned process."@en ,
                                                                                                     "Eine Rolle, die einer Entität innewohnt und realisiert wird, wenn diese Entität in einem geplanten Prozess über einen gewissen Zeitraum die Konkretisierung von Daten auf Hardware speichert."@de ;
                                                        rdfs:comment "\"A concretisation of some data\" can be read as \"a copy of some data\": the concretisation in the definition refers to data being a generally dependent continuant, which can have multiple concretisations at a time. If the here mentioned concretisation in a given data store seizes to exist, the data might still exist elsewhere."@en ,
                                                                     "The data storage role does not necessarily include formalised data maintenance or defined data governance. We note however, that both are beneficial for a successful long-term preservation of data within a data store. An entity which fulfils the data storage role in one process might also fulfil the data source role in another process - i.e. when making the stored data accessible for e.g. harvesting or download."@en ;
                                                        rdfs:label "data storage role"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006032
<https://purls.helmholtz-metadaten.de/hob/HDO_00006032> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001011> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process during which a concretization of data is retained for a defined amount of time in a data store."@en ,
                                                                                                     "Ein geplanter Prozess, bei dem eine Konkretisierung von Daten für eine bestimmte Zeit in einem Datenspeicher aufbewahrt wird."@de ;
                                                        rdfs:comment "Regarding the term \"concretization\" in the definition please see comment in HDO_00006031 \"data storage role\"."@en ;
                                                        rdfs:label "Datenspeicherung"@de ,
                                                                   "data storing"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006072
<https://purls.helmholtz-metadaten.de/hob/HDO_00006072> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000108> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A digital repository which is used to define and describe data types in an arbitrary granularity and to assign persistent identifiers to these types."@en ,
                                                                                                     "Ein digitales Repository, welches dazu verwendet wird Datentypen in beliebiger Granularität zu definieren und zu beschreiben und diesen Typen persistente Identifikatoren zuzuweisen."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://helmholtz-metadaten.de/storage/471/UseCase-Flyer_DTR.pdf" ;
                                                        rdfs:label "Registry für Datentypen"@de ,
                                                                   "data type registry"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006073
<https://purls.helmholtz-metadaten.de/hob/HDO_00006073> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000033> ,
                                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001005> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A specification which defines the rules for accessing and interacting with objects in a digital environment."@en ,
                                                                                                     "Eine Spezifikation, die die Regeln für den Zugriff und die Interaktion mit digitalen Objekten in deren Umgebung definiert."@de ;
                                                        rdfs:label "Access-Protokoll"@de ,
                                                                   "access protocol"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006084
<https://purls.helmholtz-metadaten.de/hob/HDO_00006084> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000040> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A schema which describes the structure of a metadata record of a digital resource."@en ,
                                                                                                     "Ein Schema welches die Struktur von Metadateneinträgen einer digitalen resource beschreibt."@de ;
                                                        rdfs:label "Informationsprofil"@de ,
                                                                   "information profile"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00006085
<https://purls.helmholtz-metadaten.de/hob/HDO_00006085> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001036> ,
                                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00006084> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "An information profile which only structures the metadata deemed to be essential for a given purpose."@en ,
                                                                                                     "Ein Informationsprofil, welches die für einen bestimmten Vorgang als essentiell eingestuften Metadaten strukturiert."@de ;
                                                        rdfs:comment "This definition is intentionally generic and broad - what is considered \"core\" information can vary dramatically based on application contexts and stakeholder groups. Subclasses and instances of this class can be created for particular purposes."@en ;
                                                        rdfs:label "Kernel Informationsprofil"@de ,
                                                                   "kernel information profile"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007001
<https://purls.helmholtz-metadaten.de/hob/HDO_00007001> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A material entity which is a whole or part of an electronic system that 1) executes commands, and/or 2) processes signals in digital or analogue form."@en ,
                                                                                                     "Eine materielle Entität, die als Ganzes oder als Teil eines  elektronisches System fungiert das  Befehle oder Anweisungen zur Verarbeitung von Signalen in digitaler oder analoger Form ausführt."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Computer Hardware"@de ,
                                                                                                                        "computer hardware"@en ;
                                                        rdfs:comment """We acknowledge that the term hardware is often used with respect to computer components. WIthin the scope of HDO we use this class in a wider sense to be able to also accomodate laboratory hardware. In the future more specific subclasses such as computer hardware could be created to accomodate classes like GPU, CPU or HDD. 

We also acknowledge the use of the term hardware for tools and tooling but find this meaning to be outside of the HDO scope."""@en ,
                                                                     "Wir erkennen an, dass der Begriff Hardware oft in Bezug auf Computerkomponenten verwendet wird. Im Rahmen von HDO verwenden wir diese Klasse in einem weiteren Sinne, um auch Laborhardware zu berücksichtigen. In Zukunft könnten spezifischere Unterklassen wie Computer-Hardware geschaffen werden, um auch Klassen wie GPU, CPU oder HDD zu berücksichtigen."@de ;
                                                        rdfs:label "Hardware"@de ,
                                                                   "hardware"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007002
<https://purls.helmholtz-metadaten.de/hob/HDO_00007002> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00001011> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A planned process through which information about an entity is inferred, extracted from data."@en ,
                                                                                                     "Ein geplanter Prozess, durch den Informationen über eine Entität aus Daten abgeleitet werden."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Statistik"@de ,
                                                                                                                         "statistics"@en ;
                                                        rdfs:comment """The output of the analysis process may either be a transformed version of the input data or created de novo during the analysis process in both cases it need to serve an information role. We also consider signifiers to be a possible output of data analysis. This is described by the following example.

During the MRI the magnetic signals are measured. These are analyzed from an image that can be considered data. Also it can be considered a signifier as only further analysis by a doctor (or a machine agent) a tissue damage can be diagnosed. In any case the output has to serve an information role for the process to be considered data analysis. In this example the input data is transformed during the analysis process in order to become informative."""@en ;
                                                        rdfs:label "Datenanalyse"@de ,
                                                                   "data analysis"@en ;
                                                        rdfs:seeAlso "http://purl.obolibrary.org/obo/OBI_0200000" ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "Datenanalysen"@de ,
                                                                                                                "data analyses"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007003
<https://purls.helmholtz-metadaten.de/hob/HDO_00007003> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A role which inheres in a generically dependent continuant and is realized when that generically dependent continuant indicates the existence, identity, properties, or behaviours of another entity."@en ,
                                                                                                     "Eine Rolle, die einer Entität innewohnt und die verwirklicht wird, wenn diese Entität als repräsentativ für eine andere interpretiert wird"@en ;
                                                        rdfs:label "Signalisierungrolle"@de ,
                                                                   "signifier role"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007004
<https://purls.helmholtz-metadaten.de/hob/HDO_00007004> rdf:type owl:Class ;
                                                        owl:equivalentClass [ owl:intersectionOf ( <http://purl.obolibrary.org/obo/BFO_0000031>
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty <https://purls.helmholtz-metadaten.de/hob/HDO_00006036> ;
                                                                                                     owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00007003>
                                                                                                   ]
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ] ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ,
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <https://purls.helmholtz-metadaten.de/hob/HDO_00006036> ;
                                                                          owl:someValuesFrom <https://purls.helmholtz-metadaten.de/hob/HDO_00007003>
                                                                        ] ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A generically dependent continuant which realizes a signifier role."@en ,
                                                                                                     "Ein generisch abhängiges Kontinuum, das eine Signifier-Rolle umsetzt."@de ;
                                                        <http://purl.org/dc/elements/1.1/contributor> <https://orcid.org/0000-0002-3949-818X> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Zeichen einer Qualität"@de ,
                                                                                                                       "signifier of a quality"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "symbol"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "indicator"@en ,
                                                                                                                         "representational entity"@en ,
                                                                                                                         "sign"@en ,
                                                                                                                         "signal"@en ;
                                                        rdfs:comment """Example: A fingerprint on a pane of glass that indicates an individual which may have touched the glass at some point in time.

In the example, note that the fingerprint itself is not the signifier but realizes the signifier role. The signifier depends on the entity that realizes the signifier role (i.e. the fingerprint) and the entity performing the interpretation (i.e putting the signifier in relation to previous experience) leading to the conclusion that the fingerprint might indicate the interaction of an individual with the pane of glass."""@en ,
                                                                     """Example: a symbol for dangerous goods on a sticker placed on e.g. trucks or on bottles in a laboratory, which indicates a property of the contained substance (i.e. acidic,  flammable).

In the example, note that the physically printed symbol for dangerous goods itself is not the signifier but realizes the signifier role. The signifier depends on the entity that realizes the signifier role (i.e. the symbol on the sticker) and the entity performing the interpretation (i.e putting the signifier in relation to previous experience) leading to the conclusion that the symbol on the sticker might indicate the presence of a dangerous substrance."""@en ,
                                                                     """Example: smoke that indicates the presence of a combustion process.

In the example, note that the smoke itself is not the signifier but realizes the signifier role. The signifier depends on the entity that realizes the signifier role (i.e. the smoke) and the entity performing the interpretation (i.e putting the signifier in relation to previous experience) leading to the conclusion that the smoke might indicate the presence of a fire."""@en ,
                                                                     "The generic dependence of a signifier is on the entity that realizes the signifier role, not on the entity which is signified."@en ,
                                                                     "The term 'indicates' in the definition implies an interpretation process which will have as output either information or mis-information."@en ;
                                                        rdfs:label "Zeichen"@de ,
                                                                   "signifier"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://purls.helmholtz-metadaten.de/hob/HDO_00007004> ;
   owl:annotatedProperty <http://purl.org/dc/elements/1.1/contributor> ;
   owl:annotatedTarget <https://orcid.org/0000-0002-3949-818X> ;
   rdfs:comment "Jos Lehmann"
 ] .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007005
<https://purls.helmholtz-metadaten.de/hob/HDO_00007005> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A quality which inheres in a bearer by virtue of the variation in that bearer's qualities or parts."@en ,
                                                                                                     "Eine Eigenschaft die ein Träger oder einer Trägerin, aufgrund der Veränderlichkeit seiner oder ihrer Eigenschaften oder Teile hat."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://en.wikipedia.org/wiki/Information_content> ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Shannon entropy"@en ,
                                                                                                                       "information content"@en ,
                                                                                                                       "surprisal"@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "information"@en ;
                                                        rdfs:comment "For example, the self-information of the string \"AAAAAAA\" is null (no variation), while that of the string \"ABRPGE3\" is high. This is aligned to the notion of Shannon entropy, which is often derived from the probability of an event occuring: a 100% chance of an event occuring corresponds to zero information (no variation)."@en ,
                                                                     "This class is distinct from \"information\" in the more colloquial sense (i.e. informative content), which we express in HDO's \"information role\"."@en ;
                                                        rdfs:label "self-information"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007008
<https://purls.helmholtz-metadaten.de/hob/HDO_00007008> rdf:type owl:Class ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "OBSOLETE A generically dependent continuant which is composed of at least two datum instances."@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#consider> <https://purls.helmholtz-metadaten.de/hob/HDO_00000009> ,
                                                                                                                <https://purls.helmholtz-metadaten.de/hob/HDO_00001037> ;
                                                        rdfs:comment "Colloquially, \"data\" is sometimes used to refer to anything that can be perceived. Here, however, we require that those sense-impressions are encoded such that they can be recorded, transmitted, and understood by at least one agent."@en ,
                                                                     "We have created this class as most digital entities involve 'data' rather than a singular datum. How to position this at the BFO upper-level is still under discussion. The definition of data as a generically dependent continuant which is composed of at least two datum instances is correct, however some intervening class expressing a collection of generically dependent continuants may be useful in future (parallel to BFO:'object aggregate')."@en ,
                                                                     "Now inlcuded as the plural of datum." ;
                                                        rdfs:label "obsolete data"@en ;
                                                        owl:deprecated "true"^^xsd:boolean ;
                                                        <http://www.w3.org/2004/02/skos/core#note> """A collection of signs, signals, symbols, or other signifiers (e.g. numbers, characters in a known alphabet, strings with an assigned meaning, known graphical symbols, viewable images) which (1) represent one or more entities or their properties and (2) have been recorded in a manner that allows their transmission.

An example: A collection of numbers which represent radio waves and have been recorded on a hard drive. The numbers are the signs mentioned above. The radio waves are also signals but not the ones mentioned above."""@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007010
<https://purls.helmholtz-metadaten.de/hob/HDO_00007010> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A disposition which inheres in an agent and which is realised when that agent successfully coordinates one or more of its operations with those of another agent."@en ,
                                                                                                     "Eine Veranlagung eines Akteurs, die realisiert wird, wenn dieser Akteur erfolgreich mit einem anderen Akteur kommuniziert."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCIT_C142381> ,
                                                                                                                 <http://wordnetweb.princeton.edu/perl/webwn?o2=&o0=1&o8=1&o1=1&o7=&o5=&o9=&o6=&o3=&o4=&s=interoperability&h=0&j=0#c> ,
                                                                                                                 <https://www.merriam-webster.com/dictionary/interoperability> ;
                                                        rdfs:comment "Interoperation implies that all participating agents are able to complete a joint operation based on the information they exchange. We note that communication is an essential part of the coordination of operations mentioned in the definition. "@en ;
                                                        rdfs:label "Interoperabilität"@de ,
                                                                   "interoperability"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "Das Potential zweier verschiedener Akteure zusammenzuarbeiten. Ein Akteur kann ein Mensch oder eine Maschine sein. "@de ,
                                                                                                   "The potential of two different agents to work together. An agent may be a human or a machine."@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007011
<https://purls.helmholtz-metadaten.de/hob/HDO_00007011> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007010> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Interoperability which is realised when the involved agents use one or more formal languages for knowledge representation to coordinate their operations."@en ,
                                                                                                     "Interoperabilität, die realisiert wird, wenn die beteiligten Akteure eine formale Sprache für Wissensrepräsentation benutzen um ihre Operationen zu koordinieren."@de ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/NCIT_C142682> ;
                                                        rdfs:label "Semantische Interoperabilität"@de ,
                                                                   "semantic interoperability"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "Das Potential zweier verschiedener Akteure zusammenzuarbeiten, indem sie Informationen austauschen, die mithilfe einer eindeutig definierten Terminologie strukturiert sind."@de ,
                                                                                                   "The potential of agents to coordinate their activity by referencing a common understanding or system of knowledge. "@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007012
<https://purls.helmholtz-metadaten.de/hob/HDO_00007012> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00007010> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000125> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Eine semantische Interoperabilitätsveranlagung, die realisiert wird, wenn die formalen Sprachen für Wissensrepräsentation (1) breit anwendbar sind, (2) FAIR kodiert sind und (3) benutzt werden um Beziehungen zu anderen (Meta)Daten zu qualifizieren. "@de ,
                                                                                                     "Semantic interoperability which is realised when the formal languages for knowledge representation are (1) broadly applicable, (2) their encodings are FAIR, and (3) they are used to qualify references to other (meta)data."@en ;
                                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <https://doi.org/10.1038/sdata.2016.18> ,
                                                                                                                 <https://www.go-fair.org/fair-principles/> ;
                                                        rdfs:comment "\"Broadly applicable\" as used in the I1 subprinciple of the FAIR principles is somewhat ambiguous. It may suggest either that the language for knowledge representation is broadly applied or that it can be broadly applied. In HMC we would favor that such languages are well used by at least the stakeholder communities (i.e. are a de facto standard) and that their technical quality allows even broader use. As opposed to the FAIR principles, our definitions do not directly talk about (meta)data but describe it indirectly through the inter-agent communication. Part of our rationale was that data by itself is not an agent and thus cannot interoperate with someone or something as might be assumed by the wording of the FAIR principles."@en ;
                                                        rdfs:label "Interoperabilität entsprechend den FAIR-Prinzipien"@de ,
                                                                   "interoperability according to the FAIR principles"@en ;
                                                        <http://www.w3.org/2004/02/skos/core#note> "Das Potential zweier verschiedener Akteure zusammenzuarbeiten, indem sie Informationen austauschen, die mit einer eindeutig definierten und den FAIR-Prinzipien folgenden Terminologie strukturiert sind."@de ,
                                                                                                   "The potential of agents to work together by referencing a digitised terminology that follows the FAIR principles."@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007015
<https://purls.helmholtz-metadaten.de/hob/HDO_00007015> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A role which inheres in an entity and is realised when this entity allows data to be accessed in a planned process."@en ,
                                                                                                     "Eine Rolle, die einer Entität innewohnt und realisiert wird, wenn diese Entität in einem geplanten Prozess den Zugriff auf Daten ermöglicht."@de ;
                                                        rdfs:comment "The accessed data is in fact a concretization of data. Please see comment in HDO_00006031 \"data storage role\""@en ,
                                                                     "The data that is being made accessible by a data source might have been stored by that entity (then this entity has fulfilled a data storage role before). It might also be output of a measurement process (HDO_00001070) by scientific devices such as instruments or sensors."@en ;
                                                        rdfs:label "Datenquellenrolle"@de ,
                                                                   "data source role"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007022
<https://purls.helmholtz-metadaten.de/hob/HDO_00007022> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "A role which inheres in a generally dependent continuant, and is realised when that generally dependent continuant reduces uncertainty about the existence, identity, or properties of the entity it represents."@en ,
                                                                                                     "Eine Rolle die einem generally dependent continuant innewohnt, und die realisiert wird, wenn dieses generally dependent continuant die Ungewissheit bezüglich der Existenz, Identität oder der Eigenschaften einer Entität die es repräsentiert, verringert."@de ;
                                                        rdfs:label "Informations Rolle"@de ,
                                                                   "information role"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007023
<https://purls.helmholtz-metadaten.de/hob/HDO_00007023> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://purls.helmholtz-metadaten.de/hob/HDO_00000009> ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "Data which encode a signifier."@en ,
                                                                                                     "Daten, die ein Zeichen kodieren."@de ;
                                                        rdfs:label "qualitative Daten"@de ,
                                                                   "qualitative data"@en ;
                                                        <https://purls.helmholtz-metadaten.de/hob/HDO_00001024> "qualitative Daten"@de ,
                                                                                                                "qualitative data"@en .


###  https://purls.helmholtz-metadaten.de/hob/HDO_00007024
<https://purls.helmholtz-metadaten.de/hob/HDO_00007024> rdf:type owl:Class ;
                                                        <http://purl.obolibrary.org/obo/IAO_0000115> "OBSOLETE A signifier which is the output of a qualification process."@en ,
                                                                                                     "OBSOLETE Ein Zeichen, das das Ergebnis eines Qualifizierungsprozesses ist."@de ;
                                                        <http://purl.obolibrary.org/obo/IAO_0100001> <https://purls.helmholtz-metadaten.de/hob/HDO_00007004> ;
